{
  "name": "@sycee-ui/vue",
  "version": "0.1.0",
  "description": "Sycee UI for Vue 3 — a unified design system with first-class Vue components. Pairs with @sycee-ui/react.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ui",
    "components",
    "vue",
    "vue3",
    "design-system",
    "component-library",
    "typescript",
    "vite",
    "dark-mode",
    "theming"
  ],
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@sycee-ui/styles": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@volar/typescript": "^2.4.0",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "sass": "^1.108.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
