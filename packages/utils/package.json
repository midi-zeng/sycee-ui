{
  "name": "@sycee-ui/utils",
  "version": "0.2.0",
  "description": "Framework-agnostic formatting and utility helpers for Sycee UI.",
  "license": "MIT",
  "type": "module",
  "keywords": ["ui", "utils", "format", "date", "number", "typescript"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
