{
  "name": "sycee-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sycee UI monorepo — a unified design system with first-class packages for React and Vue.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sycee-ui/docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "oxlint .",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.3",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
